# Copy to .env for local development. Never commit a real .env.
NODE_ENV=development
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug
LOG_PRETTY=true
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://quickpick:quickpick@localhost:5432/quickpick
DB_SLOW_QUERY_MS=500
REDIS_URL=redis://localhost:6379

# Local-only development values; deployed environments inject real secrets.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# Development only — fixes every OTP to this code and refuses to boot in production.
OTP_DEV_CODE=123456

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quickpick-media
S3_ACCESS_KEY_ID=quickpick
S3_SECRET_ACCESS_KEY=quickpick-secret
S3_FORCE_PATH_STYLE=true

ORDER_ACCEPT_SLA_SECONDS=600
ORDER_PICKUP_EXPIRY_HOURS=24
